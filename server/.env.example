# AthleteConnect — Server Environment Configuration (Template)
# Copy this file to .env for local development

# HTTP Server Port
PORT=5000

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB example: mongodb://127.0.0.1:27017/athleteconnect
# In production, provide a secure connection string with authenticated credentials
MONGODB_URI=mongodb://127.0.0.1:27017/athleteconnect

# CORS Allowed Origin
# Default allows the Phase 1 admin frontend development server
CORS_ORIGIN=http://localhost:5173

# JWT Authentication Configuration
# JWT_SECRET must be at least 32 characters. Do not use placeholders or commit secrets to version control.
# Generate a secure 256-bit secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_chars

# JWT Token Expiration (e.g., '7d', '24h', '1h')
JWT_EXPIRES_IN=7d

# Razorpay Sandbox Test Credentials (DEVELOPMENT / TEST MODE ONLY)
# Never configure live (rzp_live_*) keys in non-production environments
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Marketplace Financial Configuration
PLATFORM_COMMISSION_PERCENTAGE=20
COACH_ALLOCATION_PERCENTAGE=80
TAX_RATE_PERCENTAGE=0
PAYMENT_EXPIRY_MINUTES=120
